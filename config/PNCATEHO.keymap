#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

// CONFIG
#define COMBO_TIMEOUT 70
#define COMBO_LAYERS 0
#define COMBO_LAYER 0
#define SELECTION_LAYER 1
#define NAVIGATION_LAYER 2
#define BLUETOOTH_LAYER 3
#define KBCTRL_LAYER 4
#define RGB_LAYER 5
#define STICKY_TIMEOUT 500

// SWITCHES
#define SN 0  // TOP
#define SA 1  // TOP
#define SE 2  // TOP
#define SO 3  // TOP
#define SP 4  // BOTTOM
#define SC 5  // BOTTOM
#define ST 6  // BOTTOM
#define SH 7  // BOTTOM
#define SOT 8 // O-THUMB
#define SIT 9 // I-THUMB

&sk {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
};

/ {
  combos {
    compatible = "zmk,combos";

    combo_l_space {
        timeout-ms = <COMBO_TIMEOUT>;
        bindings = <&kp SPACE>;
        key-positions = <SIT>;
        layers = <COMBO_LAYERS>;
    };

    combo_l_bspc {
        timeout-ms = <COMBO_TIMEOUT>;
        bindings = <&kp BSPC>;
        key-positions = <SOT>;
        layers = <COMBO_LAYERS>;
    };

    #include "chords.dtsi"
  };

  keymap {
    compatible = "zmk,keymap";

    combo_layer {
      label = "combo";
      bindings = <
        &none &none &none &none
        &none &none &none &none
                          &none &none
      >;
    };

    selection_layer {
      label = "selection";
      bindings = <
        &to NAVIGATION_LAYER &none &none           &to BLUETOOTH_LAYER
        &to RGB_LAYER        &none &none           &to KBCTRL_LAYER
                                   &to COMBO_LAYER &none
      >;
    };

    navigation_layer {
      label = "navigation";
      bindings = <
        &kp PG_UP   &kp END  &kp UP          &kp HOME
        &kp PG_DOWN &kp LEFT &kp DOWN        &kp RIGHT
                             &to COMBO_LAYER &none
      >;
    };

    bluetooth_layer {
      label = "bluetooth";
      bindings = <
        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2    &bt BT_SEL 3
        &bt BT_CLR   &none        &bt BT_PRV      &bt BT_NXT
                                  &to COMBO_LAYER &none
      >;
    };

    kbctrl_layer {
      label = "kbctrl";
      bindings = <
        &bootloader &none &none           &studio_unlock
        &sys_reset  &none &none           &none
                          &to COMBO_LAYER &none
      >;
    };

    rgb_layer {
      label = "rgb";
      bindings = <
        &ext_power EP_TOG &rgb_ug RGB_BRI &rgb_ug RGB_SPI &rgb_ug RGB_EFF
        &none             &rgb_ug RGB_BRD &rgb_ug RGB_SPD &rgb_ug RGB_EFR
                                          &to COMBO_LAYER &none
      >;
    };
  };
};
